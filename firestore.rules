rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function userOwnsDoc() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    match /squads/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /users/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || userOwnsDoc());
    }

    match /squadRoles/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /squadrole/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /squadroles/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /tickets/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /projects/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /permissions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CRITICAL: permissionProfiles controls all menu visibility
    match /permissionProfiles/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /jqlConfigs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /operacao/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /municipios/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /holydays/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /holidays/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /vacations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /roadmap_geral_views/{document=**} {
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow write: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /allocations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /automations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /ciclo_views/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /ciclos_planejamento/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /components/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /customFields/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /escopo/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /estimationRules/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /estimations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /grupo_atendimento/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /jira_sync_audit/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /notifications/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /operacao_stats/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /specifications/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /system_access_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    match /systemSettings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /systems/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /t_shirts/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /tech_specifications/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /ticketTypes/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /tickets_global/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /workflows/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Catch-all: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
